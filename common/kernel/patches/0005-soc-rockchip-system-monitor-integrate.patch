--- a/drivers/soc/rockchip/Kconfig
+++ b/drivers/soc/rockchip/Kconfig
@@ -30,4 +30,32 @@
 	  on this platform. That will create all the power capping capable
 	  devices.
 
+config ROCKCHIP_PVTM
+	tristate "Rockchip PVTM support"
+	help
+	  Say Y here to enable PVTM support.  The Process-Voltage-Temperature
+	  Monitor (PVTM) measures chip performance variance caused by process,
+	  voltage and temperature.
+
+config ROCKCHIP_IPA
+	tristate "Rockchip IPA support"
+	depends on THERMAL && OF
+	help
+	  Say y here to enable Rockchip IPA support.  It provides a simple
+	  power model for IPA to calculate static and dynamic power.
+
+config ROCKCHIP_OPP
+	tristate "Rockchip OPP select support"
+	depends on PM_DEVFREQ
+	help
+	  Say y here to enable Rockchip OPP selection and voltage scaling
+	  support used by Rockchip media and accelerator drivers.
+
+config ROCKCHIP_SYSTEM_MONITOR
+	tristate "Rockchip system monitor support"
+	depends on PM_DEVFREQ
+	help
+	  Say y here to enable the Rockchip thermal/OPP system monitor used
+	  by Rockchip CPU, GPU, NPU and multimedia drivers.
+
 endif
--- a/drivers/soc/rockchip/Makefile
+++ b/drivers/soc/rockchip/Makefile
@@ -5,3 +5,7 @@
 obj-$(CONFIG_ROCKCHIP_GRF) += grf.o
 obj-$(CONFIG_ROCKCHIP_IODOMAIN) += io-domain.o
 obj-$(CONFIG_ROCKCHIP_DTPM) += dtpm.o
+obj-$(CONFIG_ROCKCHIP_IPA) += rockchip_ipa.o
+obj-$(CONFIG_ROCKCHIP_OPP) += rockchip_opp_select.o
+obj-$(CONFIG_ROCKCHIP_PVTM) += rockchip_pvtm.o
+obj-$(CONFIG_ROCKCHIP_SYSTEM_MONITOR) += rockchip_system_monitor.o
