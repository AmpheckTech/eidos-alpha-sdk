[Unit]
Description=Weston terminal on the Eidos Alpha display
Requires=weston.service
After=weston.service

[Service]
Type=simple
User=ubuntu
Environment=HOME=/home/ubuntu
Environment=XDG_RUNTIME_DIR=/run/weston
Environment=WAYLAND_DISPLAY=eidos-wayland-0
ExecStart=/usr/bin/weston-terminal
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
