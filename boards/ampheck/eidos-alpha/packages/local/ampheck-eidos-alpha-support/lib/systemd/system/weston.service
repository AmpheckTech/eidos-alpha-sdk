[Unit]
Description=Weston Wayland compositor on DRM/KMS
Documentation=man:weston(1) man:weston.ini(5)
StartLimitIntervalSec=0
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=ubuntu
PAMName=login
Environment=HOME=/home/ubuntu
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SEAT=seat0
Environment=XDG_VTNR=1
Environment=LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu/mali
LogsDirectory=weston
LogsDirectoryMode=0750
ExecStart=/usr/bin/weston --backend=drm-backend.so --renderer=gl --socket=eidos-wayland-0 --idle-time=0 --continue-without-input --log=/var/log/weston/weston.log
Restart=always
RestartSec=2
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
