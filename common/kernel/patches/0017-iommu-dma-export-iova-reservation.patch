 /* sysfs updates are serialised by the mutex of the group owning @domain */
+int iommu_dma_reserve_iova(struct iommu_domain *domain, dma_addr_t iova,
+			   size_t size)
+{
+	struct iova_domain *iovad;
+	unsigned long pfn_lo, pfn_hi;
+
+	if (!domain || !domain->iova_cookie || !size)
+		return -EINVAL;
+
+	iovad = &domain->iova_cookie->iovad;
+	pfn_lo = iova_pfn(iovad, iova);
+	pfn_hi = iova_pfn(iovad, iova + size - 1);
+
+	return reserve_iova(iovad, pfn_lo, pfn_hi) ? 0 : -EINVAL;
+}
+EXPORT_SYMBOL_GPL(iommu_dma_reserve_iova);
+
 int iommu_dma_init_fq(struct iommu_domain *domain)
