--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -868,6 +868,28 @@
 	  This is a Video4Linux2 sensor driver for the ST VGXY61
 	  camera sensor.
 
+config VIDEO_RK628
+	tristate "Rockchip RK628 HDMI-RX to MIPI CSI-2 bridge"
+	depends on VIDEO_DEV && I2C && OF
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select V4L2_FWNODE
+	select REGMAP_I2C
+	select GENERIC_PHY
+	select GENERIC_PHY_MIPI_DPHY
+	select GPIOLIB
+	select EXTCON
+	select HDMI
+	select CEC_CORE
+	help
+	  Support for the Rockchip RK628 HDMI receiver bridge. The bridge
+	  converts HDMI input into a MIPI CSI-2 stream and exposes it as a
+	  V4L2 subdevice.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called video-rk628.
+
+
 source "drivers/media/i2c/ccs/Kconfig"
 source "drivers/media/i2c/et8ek8/Kconfig"
 
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -127,6 +127,7 @@
 obj-$(CONFIG_VIDEO_OV9734) += ov9734.o
 obj-$(CONFIG_VIDEO_RDACM20) += rdacm20.o
 obj-$(CONFIG_VIDEO_RDACM21) += rdacm21.o
+obj-$(CONFIG_VIDEO_RK628) += rk628/
 obj-$(CONFIG_VIDEO_RJ54N1) += rj54n1cb0c.o
 obj-$(CONFIG_VIDEO_S5C73M3) += s5c73m3/
 obj-$(CONFIG_VIDEO_S5K3M5) += s5k3m5.o
