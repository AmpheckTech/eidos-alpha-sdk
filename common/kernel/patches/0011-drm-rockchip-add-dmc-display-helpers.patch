+int rockchip_drm_get_sub_dev_type(void)
+{
+	struct drm_connector_list_iter iter;
+	struct drm_connector *connector;
+	struct drm_device *drm_dev = READ_ONCE(rockchip_drm_primary);
+	int connector_type = DRM_MODE_CONNECTOR_Unknown;
+
+	if (!drm_dev)
+		return connector_type;
+
+	drm_connector_list_iter_begin(drm_dev, &iter);
+	drm_for_each_connector_iter(connector, &iter) {
+		if (connector->state && connector->state->crtc) {
+			connector_type = connector->connector_type;
+			break;
+		}
+	}
+	drm_connector_list_iter_end(&iter);
+
+	return connector_type;
+}
+EXPORT_SYMBOL_GPL(rockchip_drm_get_sub_dev_type);
+
+u32 rockchip_drm_get_scan_line_time_ns(void)
+{
+	struct drm_connector_list_iter iter;
+	struct drm_display_mode *mode;
+	struct drm_connector *connector;
+	struct drm_device *drm_dev = READ_ONCE(rockchip_drm_primary);
+	u32 line_time_ns = 0;
+
+	if (!drm_dev)
+		return 0;
+
+	drm_connector_list_iter_begin(drm_dev, &iter);
+	drm_for_each_connector_iter(connector, &iter) {
+		if (!connector->state || !connector->state->crtc ||
+		    !connector->state->crtc->state)
+			continue;
+
+		mode = &connector->state->crtc->state->adjusted_mode;
+		if (!mode->crtc_clock)
+			continue;
+
+		line_time_ns = div_u64((u64)mode->crtc_htotal * USEC_PER_SEC,
+				       mode->crtc_clock);
+		break;
+	}
+	drm_connector_list_iter_end(&iter);
+
+	return line_time_ns;
+}
+EXPORT_SYMBOL_GPL(rockchip_drm_get_scan_line_time_ns);
