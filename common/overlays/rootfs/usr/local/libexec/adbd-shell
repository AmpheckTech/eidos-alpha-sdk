#!/bin/bash

# adbd hardcodes /bin/sh for shell sessions. Keep non-adbd callers on dash,
# but run sessions launched by adbd with bash.
parent="$(readlink -f "/proc/$PPID/exe" 2>/dev/null || true)"
case "$parent" in
	*/adbd)
		if [ -z "${TERM:-}" ] || [ "$TERM" = "dumb" ]; then
			export TERM=xterm-256color
		fi
		export force_color_prompt=yes
		exec /bin/bash "$@"
		;;
esac

exec /bin/dash "$@"
